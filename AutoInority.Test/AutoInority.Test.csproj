<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <OutputType>Library</OutputType>

    <ApplicationIcon />

    <StartupObject />

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Bridges/AngelaConversationUI.cs 与真游戏类型同名遮蔽（CS0436），缘由见该文件头注释 -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    挂载真游戏 DLL（lib/ 九件套入库，仓库自带完整物料）：通配链入主工程源码，
    编译期符号全部对齐真实游戏 API（唯一例外：Bridges/AngelaConversationUI.cs 源码
    遮蔽，缘由见该文件头注释）。Exclude：Properties（AssemblyInfo/资源生成器冲突）。
    Graph.xml 以 LogicalName 嵌入（Graph.cs 按清单名 "AutoInority.Graph.xml" 读取，
    与主工程 RootNamespace 对齐）。运行时桥接（跳构造器分配 + 反射注字段 + 单例注入）
    见 Bridges/GameBridge.cs。
  -->
  <ItemGroup>
    <Compile Include="..\AutoInority\**\*.cs" Exclude="..\AutoInority\Properties\**" />
    <EmbeddedResource Include="..\AutoInority\Graph.xml" LogicalName="AutoInority.Graph.xml" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\AutoInority\lib\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\AutoInority\lib\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\AutoInority\lib\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\AutoInority\lib\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\AutoInority\lib\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\AutoInority\lib\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\AutoInority\lib\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\AutoInority\lib\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\AutoInority\lib\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
